# Laravel API base URL (server-side only). Leave unset to run on the built-in
# fixture catalogue without the backend.
API_URL=http://localhost:8000/api/v1

# Hosted only: the same value as SHOP_STOREFRONT_KEY on the API, so it can rate-limit
# each shopper by the IP this server forwards. Not needed locally.
STOREFRONT_KEY=

# ISO 4217 currency used for display. Must match SHOP_CURRENCY in backend/.env.
NEXT_PUBLIC_CURRENCY=SDG
